# MediaMTX API - VS Code REST Client
# API Server:      http://localhost:9997/
# Playback Server: http://localhost:9996/
# Docs: https://github.com/bluenviron/mediamtx
# Tool: https://github.com/Huachao/vscode-restclient

@apiBase = http://localhost:9997
@recordingBase = http://localhost:9996
@pathName = mystream
@sessionId = 00000000-0000-0000-0000-000000000000


# ============================================================
# General
# ============================================================

### Get server info
GET {{apiBase}}/v3/info HTTP/1.1


# ============================================================
# Authentication
# ============================================================

### Refresh JWT JWKS
POST {{apiBase}}/v3/auth/jwks/refresh HTTP/1.1


# ============================================================
# Configuration — Global
# ============================================================

### Get global configuration
GET {{apiBase}}/v3/config/global/get HTTP/1.1

### Patch global configuration (all fields optional)
PATCH {{apiBase}}/v3/config/global/patch HTTP/1.1
Content-Type: application/json

{
  "logLevel": "info",
  "logDestinations": ["stdout"],
  "readTimeout": "10s",
  "writeTimeout": "10s",
  "writeQueueSize": 512,
  "api": true,
  "apiAddress": ":9997",
  "rtsp": true,
  "rtmpEncryption": "no",
  "hls": true,
  "webrtc": true,
  "srt": true,
  "playback": true,
  "playbackAddress": ":9996"
}


# ============================================================
# Configuration — Path Defaults
# ============================================================

### Get default path configuration
GET {{apiBase}}/v3/config/pathdefaults/get HTTP/1.1

### Patch default path configuration (all fields optional)
PATCH {{apiBase}}/v3/config/pathdefaults/patch HTTP/1.1
Content-Type: application/json

{
  "source": "publisher",
  "maxReaders": 0,
  "record": false,
  "recordPath": "./recordings/%path/%Y-%m-%d_%H-%M-%S-%f",
  "recordFormat": "fmp4",
  "recordPartDuration": "1s",
  "recordSegmentDuration": "1h",
  "recordDeleteAfter": "24h"
}


# ============================================================
# Configuration — Paths
# ============================================================

### List all path configurations (paginated)
GET {{apiBase}}/v3/config/paths/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific path configuration
GET {{apiBase}}/v3/config/paths/get/{{pathName}} HTTP/1.1

### Add a new path configuration
POST {{apiBase}}/v3/config/paths/add/{{pathName}} HTTP/1.1
Content-Type: application/json

{
  "source": "publisher",
  "record": false,
  "maxReaders": 0,
  "runOnDemand": "",
  "runOnReady": "",
  "runOnRead": ""
}

### Patch (partially update) a path configuration
PATCH {{apiBase}}/v3/config/paths/patch/{{pathName}} HTTP/1.1
Content-Type: application/json

{
  "record": true,
  "recordFormat": "fmp4",
  "recordSegmentDuration": "1h"
}

### Replace (fully overwrite) a path configuration
POST {{apiBase}}/v3/config/paths/replace/{{pathName}} HTTP/1.1
Content-Type: application/json

{
  "source": "publisher",
  "record": false,
  "maxReaders": 10
}

### Delete a path configuration
DELETE {{apiBase}}/v3/config/paths/delete/{{pathName}} HTTP/1.1


# ============================================================
# Paths (Runtime)
# ============================================================

### List all active paths
GET {{apiBase}}/v3/paths/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific active path
GET {{apiBase}}/v3/paths/get/{{pathName}} HTTP/1.1


# ============================================================
# HLS — Muxers
# ============================================================

### List all HLS muxers
GET {{apiBase}}/v3/hlsmuxers/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific HLS muxer
GET {{apiBase}}/v3/hlsmuxers/get/{{pathName}} HTTP/1.1


# ============================================================
# HLS — Sessions
# ============================================================

### List all HLS sessions
GET {{apiBase}}/v3/hlssessions/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific HLS session
GET {{apiBase}}/v3/hlssessions/get/{{sessionId}} HTTP/1.1

### Kick a HLS session
POST {{apiBase}}/v3/hlssessions/kick/{{sessionId}} HTTP/1.1


# ============================================================
# RTSP — Connections
# ============================================================

### List all RTSP connections
GET {{apiBase}}/v3/rtspconns/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific RTSP connection
GET {{apiBase}}/v3/rtspconns/get/{{sessionId}} HTTP/1.1


# ============================================================
# RTSP — Sessions
# ============================================================

### List all RTSP sessions
GET {{apiBase}}/v3/rtspsessions/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific RTSP session
GET {{apiBase}}/v3/rtspsessions/get/{{sessionId}} HTTP/1.1

### Kick a RTSP session
POST {{apiBase}}/v3/rtspsessions/kick/{{sessionId}} HTTP/1.1


# ============================================================
# RTSPS — Connections
# ============================================================

### List all RTSPS connections
GET {{apiBase}}/v3/rtspsconns/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific RTSPS connection
GET {{apiBase}}/v3/rtspsconns/get/{{sessionId}} HTTP/1.1


# ============================================================
# RTSPS — Sessions
# ============================================================

### List all RTSPS sessions
