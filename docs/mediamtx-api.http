# RTMP — Connections
# ============================================================

### List all RTMP connections
GET {{apiBase}}/v3/rtmpconns/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific RTMP connection
GET {{apiBase}}/v3/rtmpconns/get/{{sessionId}} HTTP/1.1

### Kick a RTMP connection
POST {{apiBase}}/v3/rtmpconns/kick/{{sessionId}} HTTP/1.1


# ============================================================
# RTMPS — Connections
# ============================================================

### List all RTMPS connections
GET {{apiBase}}/v3/rtmpsconns/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific RTMPS connection
GET {{apiBase}}/v3/rtmpsconns/get/{{sessionId}} HTTP/1.1

### Kick a RTMPS connection
POST {{apiBase}}/v3/rtmpsconns/kick/{{sessionId}} HTTP/1.1


# ============================================================
# SRT — Connections
# ============================================================

### List all SRT connections
GET {{apiBase}}/v3/srtconns/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific SRT connection
GET {{apiBase}}/v3/srtconns/get/{{sessionId}} HTTP/1.1

### Kick a SRT connection
POST {{apiBase}}/v3/srtconns/kick/{{sessionId}} HTTP/1.1


# ============================================================
# WebRTC — Sessions
# ============================================================

### List all WebRTC sessions
GET {{apiBase}}/v3/webrtcsessions/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific WebRTC session
GET {{apiBase}}/v3/webrtcsessions/get/{{sessionId}} HTTP/1.1

### Kick a WebRTC session
POST {{apiBase}}/v3/webrtcsessions/kick/{{sessionId}} HTTP/1.1


# ============================================================
# MoQ — Sessions
# ============================================================

### List all MoQ sessions
GET {{apiBase}}/v3/moqsessions/list?page=0&itemsPerPage=100 HTTP/1.1

### Get a specific MoQ session
GET {{apiBase}}/v3/moqsessions/get/{{sessionId}} HTTP/1.1

### Kick a MoQ session
POST {{apiBase}}/v3/moqsessions/kick/{{sessionId}} HTTP/1.1


# ============================================================
# Recordings
# ============================================================

### List all recordings (grouped by path)
GET {{apiBase}}/v3/recordings/list?page=0&itemsPerPage=100 HTTP/1.1

### Get recordings for a specific path
GET {{apiBase}}/v3/recordings/get/{{pathName}} HTTP/1.1

### Delete a recording segment
# 'path' = the stream path name, 'start' = segment start time (RFC 3339)
DELETE {{apiBase}}/v3/recordings/deletesegment?path={{pathName}}&start=2024-01-01T00:00:00Z HTTP/1.1


# ============================================================
# Playback Server (port 9996)
# Serves recorded segments for on-demand playback.
# ============================================================

### Stream a recorded segment (fmp4 format)
# Replace the start param with a valid RFC 3339 timestamp from the recordings list
GET {{recordingBase}}/{{pathName}}?start=2024-01-01T00:00:00Z HTTP/1.1

